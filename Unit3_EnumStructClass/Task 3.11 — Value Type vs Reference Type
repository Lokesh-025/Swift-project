
struct Student {
    var name: String
}

class Person {
    var name: String

    init(name: String) {
        self.name = name
    }
}

// Struct: copying creates an independent value.
var student1 = Student(name: "Arun")
var student2 = student1

student2.name = "Priya"

print("Original student:", student1.name)
print("Copied student:", student2.name)

// Class: both variables refer to the same object.
let person1 = Person(name: "Arun")
let person2 = person1

person2.name = "Priya"

print("Original person:", person1.name)
print("Copied person:", person2.name)

// Struct changes do not affect the original.
// Class changes are visible through both references.
